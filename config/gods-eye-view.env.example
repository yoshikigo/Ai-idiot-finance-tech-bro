# ~/.config/fin-terminal/gods-eye-view.env — God's Eye View (EnvironmentFile; restart gods-eye-view after editing)
# Keys go HERE: the in-app POWER UP panel refuses requests that arrive through tailscale serve.
# Everything below is optional; without keys you still get flights, military aircraft, satellites,
# earthquakes, cyclones, launches, weather and the Esri globe.

# Set by install.sh to your tailnet name so the Vite server accepts that Host header.
GEV_ALLOWED_HOSTS=
# Lets FT Terminal (https://<tailnet>:8130) show the globe inside a pane (?embed=1).
GEV_EMBED_FRAME_ANCESTORS=

# 🟡 free — ships (荷莫茲／紅海／麻六甲／巴拿馬／南海／台海 vessel counts): https://aisstream.io
AISSTREAM_API_KEY=
# 🟡 free — photorealistic 3D globe + terrain (personal, non-commercial): https://cesium.com/ion
CESIUM_ION_TOKEN=
# 🟡 free — NASA FIRMS active fires: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# 🟡 optional — more OpenSky polling credits
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# 🟡 optional — higher Launch Library 2 allowance
LL2_API_TOKEN=
# 🔴 metered — voice agent / HUD captions (the app's own AI features; FT Terminal does not need it)
OPENAI_API_KEY=
