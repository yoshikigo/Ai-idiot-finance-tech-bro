# ~/.config/fin-terminal/fin-terminal.env — read by every fin-terminal / ft-* container.
# Defaults only: once you press 儲存 in the terminal's ⚙ 設定 tab, /data/settings.json wins
# for Ollama URL / models / language.

# Local Ollama (point it at a metrics/trace proxy instead if you run one).
OLLAMA_URL=http://127.0.0.1:11434
# Default model for everything. TradingAgents needs tool calling + >=32K context.
FT_MODEL=qwen3:32b
# Force num_ctx on native /api/chat calls (leave empty to use the Modelfile's num_ctx)
#FT_NUM_CTX=65536

TZ=Asia/Taipei

# ---- optional data keys (everything works without them, via yfinance) ----
# ai-hedge-fund: use Financial Datasets instead of the bundled yfinance adapter (US only)
#FINANCIAL_DATASETS_API_KEY=
# TradingAgents macro tool (free key at fred.stlouisfed.org)
#FRED_API_KEY=
# TradingAgents SEC EDGAR fundamentals want an identifying User-Agent
#SEC_EDGAR_USER_AGENT=Your Name you@example.com
#ALPHA_VANTAGE_API_KEY=

# Demo mode with synthetic prices/news (no network needed). Leave off for real data.
#FT_FAKE_DATA=1

# ---- God's Eye View (現實世界訊號：地震、軍機、航運、颶風、野火、發射) ----
# MCP endpoint of the gods-eye-view container (loopback only — never expose /mcp)
GEV_URL=http://127.0.0.1:4173
# Public (tailnet) URL of the globe, used for 開啟上帝視角 links. install.sh --tailscale fills it in.
GEV_PUBLIC_URL=
# How often world snapshots are collected (minutes). FT_WORLD=0 disables collection entirely.
#FT_WORLD_INTERVAL_MIN=60
#FT_WORLD=0

# ---- Obsidian ----
# Notes are written to /data/obsidian-outbox and moved into the vault by ft-obsidian-apply (host side).
# Folder inside the vault:
FT_OBSIDIAN_FOLDER=finance
# Base URL of this terminal, for "在 FT Terminal 開啟" links inside notes. install.sh --tailscale fills it in.
FT_PUBLIC_URL=
# FT_OBSIDIAN=0 turns off automatic notes (the 📝 button still works)
#FT_OBSIDIAN=0

# ---- 策略研究（FinLab 式研究資料庫，ft-research）----
# 月營收／財報從哪一年開始回補；日資料（本益比殖利率、三大法人、融資融券）回補幾年
#FT_RESEARCH_START=2013-01-01
#FT_RESEARCH_DAILY_YEARS=5
# 0 = 只抓最新資料、不回補歷史；FT_RESEARCH_COLLECT=0 = 完全不在背景抓
#FT_RESEARCH_BACKFILL=1
#FT_RESEARCH_COLLECT=1

# ---- TradingAgents 在本機模型上的保護（防止多空研究員寫不停）----
# 每個節點每次呼叫的輸出上限（tokens）；側欄表單的兩個欄位會覆蓋 debate／report
#FT_TA_MAX_TOKENS_REPORT=8192
#FT_TA_MAX_TOKENS_DEBATE=3072
#FT_TA_MAX_TOKENS_RISK=2048
#FT_TA_MAX_TOKENS_TRADER=3072
#FT_TA_MAX_TOKENS_MANAGER=4096
# 單次請求逾時（秒，要小於 proxy 的 15 分鐘）與重試次數（0 = 逾時就直接失敗，不重送同一個 prompt）
#FT_TA_TIMEOUT=600
#FT_TA_RETRIES=0
# 研究員／風控／交易員的 presence_penalty（例 0.3，降低重複；空白 = 不送）
#FT_TA_PRESENCE_PENALTY=

# ---- 我的持股（登入）----
# open＝網頁上可自行註冊（只在 tailnet 內）；off＝只能由管理者建立帳號：
#   podman exec -it fin-terminal python /app/terminal/auth.py add <帳號>
#FT_SIGNUP=open

# ---- 重大事件 ----
# 背景偵測指數大波動、抓當時新聞並讓 Ollama 命名（每件約 10–30 秒 GPU，一件一件慢慢做）
#FT_EVENTS=1          # 0＝整個關掉背景偵測（大事頁仍可按「重新偵測」）
#FT_EVENTS_AI=1       # 0＝只抓新聞，不用 AI 命名
#FT_EVENTS_YEARS=2    # 背景偵測幾年（「⤓ 載入近年大事」按鈕一律 10 年）

# ---- 分析紀錄與檢討 ----
#FT_LEDGER=1               # 0＝不在背景收集與核對（紀錄頁按鈕仍可用）
#FT_LEDGER_AUTO_REVIEW=1   # 0＝不自動做 AI 檢討（≥5 筆新核對且距上次 ≥7 天才會做）

# ---- SEC EDGAR（美股官方財報與申報）----
# SEC 規定 User-Agent 要有聯絡 email；沒設就只用 Yahoo
#FT_SEC_USER_AGENT="FT-Terminal you@example.com"

# FRED 總經：預設用免金鑰的 fredgraph.csv；若被擋或逾時，到 https://fredaccount.stlouisfed.org/apikeys 免費申請金鑰填這裡
#FT_FRED_API_KEY=

# 公開網址（./install.sh --no-build --cloudflare 會自動填）：這些主機名稱進來的請求全部要登入、不能註冊、不能改設定
#FT_PUBLIC_HOSTS=fin.example.com
#FT_PUBLIC_SIGNUP=off
# required：從公開網址登入一定要 TOTP 驗證碼（--cloudflare 預設）；optional：只有設了 TOTP 的帳號要
#FT_PUBLIC_TOTP=required
