[Unit]
Description=Fin Terminal engine – 策略研究 research (official TW data + backtests)
After=network-online.target
StartLimitIntervalSec=0
Wants=network-online.target

[Container]
Image=localhost/fin-terminal:latest
ContainerName=ft-research
Network=host
EnvironmentFile=%h/.config/fin-terminal/fin-terminal.env
Environment=FT_PORT=8138 FT_BIND=127.0.0.1 FT_DATA=/data PYTHONPATH=/app/common TZ=Asia/Taipei
Volume=@DATA_ROOT@/data:/data
Volume=/etc/localtime:/etc/localtime:ro
Exec=python /app/engines/research/worker.py
PodmanArgs=--memory=6g
HealthCmd=python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8138/health', timeout=5)"
HealthInterval=60s
HealthStartPeriod=60s
HealthRetries=3

[Service]
ExecStartPre=/usr/bin/test -f @DATA_ROOT@/.ft-root
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
