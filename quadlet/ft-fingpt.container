[Unit]
Description=Fin Terminal engine – FinGPT (local Ollama)
After=network-online.target
StartLimitIntervalSec=0
Wants=network-online.target

[Container]
Image=localhost/fin-terminal:latest
ContainerName=ft-fingpt
Network=host
EnvironmentFile=%h/.config/fin-terminal/fin-terminal.env
Environment=FT_PORT=8135 FT_BIND=127.0.0.1 FT_DATA=/data
Volume=@DATA_ROOT@/data:/data
Volume=/etc/localtime:/etc/localtime:ro
Exec=python /app/engines/fingpt/worker.py
PodmanArgs=--memory=4g
HealthCmd=python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8135/health', timeout=5)"
HealthInterval=60s
HealthStartPeriod=60s
HealthRetries=3

[Service]
ExecStartPre=/usr/bin/test -f @DATA_ROOT@/.ft-root
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
