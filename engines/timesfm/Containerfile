# podman build -t localhost/ft-timesfm:latest -f engines/timesfm/Containerfile .
# CPU torch: TimesFM 2.5 (200M) / 3.0 (330M) forecast one series in ~1–3 s on a laptop-class CPU,
# leaving the GPU to Ollama. Weights download from Hugging Face on first use into /data/hf.
FROM docker.io/library/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch==2.14.*"
COPY engines/timesfm/requirements.lock /tmp/req.lock
RUN pip install -r /tmp/req.lock
ARG UPSTREAM_REF=timesfm-3.0.2
COPY common /app/common
COPY engines/timesfm /app/engine
ENV PYTHONPATH=/app/common:/app/engine FT_DATA=/data UPSTREAM_REF=${UPSTREAM_REF} HF_HOME=/data/hf \
    TIMESFM_DEVICE=cpu TIMESFM_PRELOAD=1
WORKDIR /app/engine
CMD ["python", "worker.py"]
