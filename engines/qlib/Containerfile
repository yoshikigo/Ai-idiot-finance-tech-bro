# podman build -t localhost/ft-qlib:latest -f engines/qlib/Containerfile .
FROM docker.io/library/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
# lightgbm needs OpenMP
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY engines/qlib/requirements.lock /tmp/req.lock
RUN pip install -r /tmp/req.lock
ARG UPSTREAM_REF=pyqlib-0.9.7
COPY common /app/common
COPY engines/qlib /app/engine
ENV PYTHONPATH=/app/common:/app/engine FT_DATA=/data UPSTREAM_REF=${UPSTREAM_REF} \
    MLFLOW_ALLOW_FILE_STORE=true MLFLOW_DISABLE_AGENT_HINT=1
WORKDIR /app/engine
CMD ["python", "worker.py"]
